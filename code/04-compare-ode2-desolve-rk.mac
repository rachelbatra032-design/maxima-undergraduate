/* dy/dx = x, y(0) = 0, solved three ways */

/* ode2 */
eqn:'diff(y,x)=x;
sol:ode2(eqn,y,x);
fsol:ic1(sol,x=0,y=0);
wxplot2d(rhs(fsol),[x,0,2])$

/* desolve */
kill(all)$
eqn:diff(y(x),x)=x;
sol:desolve(eqn,y(x));
fsol:ev(sol,y(0)=0);
wxplot2d(rhs(fsol),[x,0,2])$

/* rk() */
eqn:'diff(y,x)=x;
fsol:rk(rhs(eqn),[y],[0],[x,0,2,0.9]);
wxplot2d([discrete,fsol])$
